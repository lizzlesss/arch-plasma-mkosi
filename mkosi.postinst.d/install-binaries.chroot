#!/usr/bin/env bash

set -xeuo pipefail

pushd .sources

pacman -U ./kcgroups-pkgbuild/*.pkg.tar.* --noconfirm --disable-sandbox
pacman -U ./dmemcg-booster/*.pkg.tar.* --noconfirm --disable-sandbox

# Remove debug packages
pacman -R kcgroups-dmemcg-debug dmemcg-booster-debug --noconfirm --disable-sandbox

popd
