#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
  exit
fi

# Ensure the sources dir exists and is empty
mkdir -p /sources
rm -rf /sources/*
cd /sources

git clone https://github.com/pixelcluster/kcgroups-pkgbuild.git
cd kcgroups-pkgbuild
env EUID=123 makepkg -o
cd /sources

mkdir -p /sources/dmemcg-booster
cd /sources/dmemcg-booster
wget https://raw.githubusercontent.com/CachyOS/CachyOS-PKGBUILDS/refs/heads/master/dmemcg-cgroup/dmemcg-booster/PKGBUILD
wget https://raw.githubusercontent.com/CachyOS/CachyOS-PKGBUILDS/refs/heads/master/dmemcg-cgroup/dmemcg-booster/dmemcg-booster.install
env EUID=123 makepkg -o
cd
